        <mxCell id="t41" value="every skill, both lanes, always — a row even when nothing has been run&lt;br&gt;&lt;br&gt;the lane is a badge on the row, not a menu&lt;br&gt;&lt;br&gt;&lt;b&gt;j k · enter&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1">
